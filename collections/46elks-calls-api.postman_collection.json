          "name": "Make a voice call",
          "request": {
            "name": "Make a voice call",
            "description": {
              "content": "Place an outbound call. voice_start is either a URL that returns the first call action or an inline JSON call-action object.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "calls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
