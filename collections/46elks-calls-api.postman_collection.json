                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "voice_start",
                  "value": "<uri>",
                  "description": "(Required) First call action - a URL returning a call action, or an inline call-action JSON object (connect, play, ivr, record, hangup)."
                },
                {
                  "disabled": false,
                  "key": "whenhangup",
                  "value": "<uri>",
                  "description": "Webhook URL notified when the call ends."
                },
                {
                  "disabled": false,
                  "key": "timeout",
