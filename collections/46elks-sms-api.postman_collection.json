          "name": "Send an SMS",
          "request": {
            "name": "Send an SMS",
            "description": {
              "content": "Send a text message to one or more mobile phones. The sender may be an alphanumeric sender ID (up to 11 characters) or an E.164 number you own.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sms"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "(Required) Alphanumeric sender ID (max 11 chars) or E.164 number."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "(Required) Recipient number in E.164 format."
                },
                {
                  "disabled": false,
                  "key": "message",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "dryrun",
                  "value": "<string>",
                  "description": "Validate without sending."
                },
                {
                  "disabled": false,
                  "key": "flashsms",
                  "value": "<string>",
                  "description": "Send as a flash SMS shown immediately, not stored."
                },
                {
                  "disabled": false,
                  "key": "whendelivered",
                  "value": "<uri>",
                  "description": "Webhook URL notified with the delivery status."
                },
                {
                  "disabled": false,
                  "key": "dontlog",
                  "value": "<string>",
                  "description": "Do not store the message text in history."
                }
              ]
            }
          },
